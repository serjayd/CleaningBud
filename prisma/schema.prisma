generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PropertyType {
  HOUSE
  FLAT
  STUDIO
}

enum ServiceType {
  REGULAR_CLEANING
  DEEP_CLEANING
  END_OF_TENANCY
  WINDOW_CLEANING
  HOME_AND_WINDOWS
}

enum ExtraService {
  OVEN_CLEANING
  FRIDGE_CLEANING
  INSIDE_CABINETS
  INTERIOR_WINDOWS
  EXTERIOR_WINDOWS
  LAUNDRY
  OTHER
}

model Quote {
  id String @id @default(cuid())

  // Property
  postcode      String
  propertyType  PropertyType @default(HOUSE)
  bedrooms      Int @default(0)
  bathrooms     Int @default(0)

  // Cleaning
  serviceType   ServiceType @default(REGULAR_CLEANING)
  extras        ExtraService[]
  cleaningDate  String
  cleaningTime  String

  // Customer
  fullName      String
  emailAddress  String
  phoneNumber   String
  propertyAddress String

  // Additional information
  notes         String?

  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([emailAddress])
  @@index([phoneNumber])
  @@index([postcode])
  @@index([cleaningDate])
  @@index([serviceType])
  @@map("quotes")
}